{
	"name": "vioraa",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0",
		"prepare": "svelte-kit sync || echo ''",
		"db:push": "node --env-file=.env scripts/push-schema.js",
		"db:seed": "node --env-file=.env scripts/seed.js",
		"smoke": "node --env-file=.env scripts/smoke.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"admin": "node --env-file=.env scripts/make-admin.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"@types/web-push": "^3.6.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"postgres": "^3.4.9",
		"web-push": "^3.6.7"
	}
}
