DATABASE_URL=postgres://user:pass@localhost:5432/vioraa
ADMIN_PASSWORD=change-me
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hamada@elhawarey.com

# --- deployment (compose.yaml reads these) ---
POSTGRES_USER=elhawarey
POSTGRES_PASSWORD=
POSTGRES_DB=elhawarey
# 0.0.0.0 publishes the port to the internet; 127.0.0.1 keeps it on the VPS
# (APP_BIND=127.0.0.1 makes nginx the only way in)
DB_BIND=0.0.0.0
APP_BIND=0.0.0.0
# the public URL nginx serves — must match exactly
ORIGIN=https://elhawarey.com
ADMIN_EMAIL=admin@elhawarey.com
ADMIN_NAME=Administrator
